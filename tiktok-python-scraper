def url_to_date(video_id):
    '''
    Converts TikTok video ID to datetime object
    Args:      video_id: post id of TikTok post from url, which contains timestamp data
    Returns:   datetime object with time the post was published
    '''
    fix_date = -41817000000  # TikTok epoch offset
    timestamp = (int(video_id) >> 22) + fix_date  # Convert to milliseconds
    dt_object = datetime.fromtimestamp(timestamp / 1000, tz=timezone.utc)  # Convert to seconds
    return dt_object

